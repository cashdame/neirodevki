# EP2 video worker — ComfyUI + 6 custom nodes for Wan 2.1 i2v pipeline.
#
# Base: runpod/worker-comfyui:5.8.5-base (same as EP1 flux-worker — proven working).
# No model weights baked in — all models live on a RunPod network volume.
# ENTRYPOINT is check_imports.py for Phase A smoke-test only.
# Phase B will replace ENTRYPOINT with entrypoint-video.sh.
#
# Layer strategy: one RUN per custom node so SHA bump rebuilds only that layer.
FROM runpod/worker-comfyui:5.8.5-base

# I4: allow custom nodes to import ComfyUI core modules (e.g. folder_paths).
# Without this, nodes like ReActor and controlnet_aux fail at load time.
ENV PYTHONPATH=/comfyui

# ---------------------------------------------------------------------------
# Layer 1: system packages
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      cmake \
      git \
      libgl1 \
      libglib2.0-0 \
      python3-dev \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Layer 2: core pip deps
# onnxruntime-gpu pinned for insightface 0.7.3 + torch CUDA 12 compatibility.
# CI iteration 2 confirmed it is NOT present in runpod/worker-comfyui:5.8.5-base.
# ---------------------------------------------------------------------------
RUN pip install --no-cache-dir \
      huggingface_hub \
      imageio \
      imageio-ffmpeg \
      av \
      onnx==1.16.1 \
      timm==0.9.16 \
      "onnxruntime-gpu>=1.18.0,<2.0.0"

# ---------------------------------------------------------------------------
# Layer 3: insightface — needs build-essential from Layer 1
# ---------------------------------------------------------------------------
RUN pip install --no-cache-dir insightface==0.7.3

# ---------------------------------------------------------------------------
# Layer 4: custom nodes (one RUN per node for independent layer caching)
# ---------------------------------------------------------------------------

# kijai/ComfyUI-WanVideoWrapper @ 088128b
RUN git clone https://github.com/kijai/ComfyUI-WanVideoWrapper \
      /comfyui/custom_nodes/ComfyUI-WanVideoWrapper \
    && cd /comfyui/custom_nodes/ComfyUI-WanVideoWrapper \
    && git checkout 088128b224242e110d3906c6750e9a3a348a659b \
    && rm -rf .git

# Fannovel16/ComfyUI-Frame-Interpolation @ 26545cc
# requirements-no-cupy.txt EXISTS at this SHA — deps pip-installed explicitly in Layer 5.
# install.py intentionally NOT run (Manager absent on serverless). cupy omitted.
RUN git clone https://github.com/Fannovel16/ComfyUI-Frame-Interpolation \
      /comfyui/custom_nodes/ComfyUI-Frame-Interpolation \
    && cd /comfyui/custom_nodes/ComfyUI-Frame-Interpolation \
    && git checkout 26545cc2dd95bc3d27f056016300673bdeee78f5 \
    && rm -rf .git

# numz/ComfyUI-SeedVR2_VideoUpscaler @ 4490bd1
RUN git clone https://github.com/numz/ComfyUI-SeedVR2_VideoUpscaler \
      /comfyui/custom_nodes/ComfyUI-SeedVR2_VideoUpscaler \
    && cd /comfyui/custom_nodes/ComfyUI-SeedVR2_VideoUpscaler \
    && git checkout 4490bd1f482e026674543386bb2a4d176da245b9 \
    && rm -rf .git

# ShmuelRonen/ComfyUI-LatentSyncWrapper @ 360d528
RUN git clone https://github.com/ShmuelRonen/ComfyUI-LatentSyncWrapper \
      /comfyui/custom_nodes/ComfyUI-LatentSyncWrapper \
    && cd /comfyui/custom_nodes/ComfyUI-LatentSyncWrapper \
    && git checkout 360d5283d7276aee68b4237b1387e594e4ce640e \
    && rm -rf .git

# Fannovel16/comfyui_controlnet_aux @ e8b689a
RUN git clone https://github.com/Fannovel16/comfyui_controlnet_aux \
      /comfyui/custom_nodes/comfyui_controlnet_aux \
    && cd /comfyui/custom_nodes/comfyui_controlnet_aux \
    && git checkout e8b689a513c3e6b63edc44066560ca5919c0576e \
    && rm -rf .git

# Gourieff/ComfyUI-ReActor @ 6ad6b35
RUN git clone https://github.com/Gourieff/ComfyUI-ReActor \
      /comfyui/custom_nodes/ComfyUI-ReActor \
    && cd /comfyui/custom_nodes/ComfyUI-ReActor \
    && git checkout 6ad6b35a4df250d14cb2abf0808c9ffedf59f747 \
    && rm -rf .git

# kijai/ComfyUI-KJNodes @ 2ac0b25
# Required by the Wan 2.2 i2v reference workflow (kijai-canonical wanvideo_2_2_I2V_A14B).
RUN git clone https://github.com/kijai/ComfyUI-KJNodes \
      /comfyui/custom_nodes/ComfyUI-KJNodes \
    && cd /comfyui/custom_nodes/ComfyUI-KJNodes \
    && git checkout 2ac0b25bbd96c2ad4f7744fb6814de563d4b8592 \
    && rm -rf .git

# Kosinkadink/ComfyUI-VideoHelperSuite @ 4ee72c0
# VHS_LoadVideo + video export nodes used in the reference workflow.
RUN git clone https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite \
      /comfyui/custom_nodes/ComfyUI-VideoHelperSuite \
    && cd /comfyui/custom_nodes/ComfyUI-VideoHelperSuite \
    && git checkout 4ee72c065db22c9d96c2427954dc69e7b908444b \
    && rm -rf .git

# kijai/ComfyUI-WanAnimatePreprocess @ 0e0b6a2
# Provides OnnxDetectionModelLoader, PoseAndFaceDetection, DrawViTPose,
# WanAnimateToVideo nodes for the Animate (motion-transfer) pipeline.
#
# opencv-python conflict: requirements.txt lists `opencv-python`, but we
# already have opencv-python-headless (from KJNodes / controlnet_aux).
# Do NOT run `pip install -r requirements.txt` here — it would install
# the conflicting GUI variant. The real runtime deps (onnx, onnxruntime-gpu,
# cv2) are already satisfied by Layer 2 and earlier custom-node installs.
RUN git clone https://github.com/kijai/ComfyUI-WanAnimatePreprocess \
      /comfyui/custom_nodes/ComfyUI-WanAnimatePreprocess \
    && cd /comfyui/custom_nodes/ComfyUI-WanAnimatePreprocess \
    && git checkout 0e0b6a2a555625acf4d4aefb780e27d06937132f \
    && rm -rf .git

# ---------------------------------------------------------------------------
# Layer 5: pip requirements from custom nodes
#
# WanVideoWrapper: has requirements.txt
# Frame-Interpolation: has requirements-no-cupy.txt @26545cc — installed explicitly below
# SeedVR2: has requirements.txt (torch/torchvision already on base — pip skips)
# LatentSyncWrapper: has requirements.txt
# controlnet_aux: has requirements.txt — contains onnxruntime-gpu which conflicts
#                 with the version already in base. Strip it before install.
# ReActor: has requirements.txt
# KJNodes: has requirements.txt (pillow, color-matcher, matplotlib, mss, opencv-python-headless)
# VideoHelperSuite: has requirements.txt (opencv-python, imageio-ffmpeg)
# WanAnimatePreprocess: requirements intentionally NOT installed here — see note above.
# ---------------------------------------------------------------------------

# Torch-version-sensitive: install torchvision from PyTorch cu126 index BEFORE any
# requirements.txt that lists it unpinned (Frame-Interpolation, SeedVR2). Ensures a
# CUDA-compatible wheel is chosen, not a PyPI CPU-only build (would import fine but
# crash RIFE at runtime on CUDA tensors). cu126 matches worker-comfyui:5.8.5-base.
RUN pip install --no-cache-dir \
      --index-url https://download.pytorch.org/whl/cu126 \
      torchvision

RUN pip install --no-cache-dir \
      -r /comfyui/custom_nodes/ComfyUI-WanVideoWrapper/requirements.txt

# Frame-Interpolation @26545cc HAS requirements-no-cupy.txt (9 pkgs); Manager install.py
# does NOT run on serverless worker-comfyui, so deps must be installed explicitly here.
# packaging -> imported in vfi_models/rife/__init__.py; torchvision -> in vfi_utils.py
# (loaded on every RIFE import). scipy -> other vfi_models. kornia -> gmfss/ifunet.
# opencv-contrib-python OMITTED — conflicts with opencv-python-headless already installed.
# cupy OMITTED — RIFE works on torch without it.
# torchvision: NOT listed here — installed from cu126 index above to prevent CPU-only wheel.
RUN pip install --no-cache-dir \
      kornia \
      scipy \
      packaging

RUN pip install --no-cache-dir \
      -r /comfyui/custom_nodes/ComfyUI-SeedVR2_VideoUpscaler/requirements.txt

RUN pip install --no-cache-dir \
      -r /comfyui/custom_nodes/ComfyUI-LatentSyncWrapper/requirements.txt

# controlnet_aux: strip onnxruntime-gpu — pinned in Layer 2; avoid double-install conflict.
RUN grep -v "^onnxruntime" \
      /comfyui/custom_nodes/comfyui_controlnet_aux/requirements.txt \
    | pip install --no-cache-dir -r /dev/stdin

RUN pip install --no-cache-dir \
      -r /comfyui/custom_nodes/ComfyUI-ReActor/requirements.txt

RUN pip install --no-cache-dir \
      -r /comfyui/custom_nodes/ComfyUI-KJNodes/requirements.txt

RUN pip install --no-cache-dir \
      -r /comfyui/custom_nodes/ComfyUI-VideoHelperSuite/requirements.txt

# ---------------------------------------------------------------------------
# Layer 6: entrypoint shim + smoke-test helper (Phase B)
# ---------------------------------------------------------------------------
COPY check_imports.py /check_imports.py
COPY entrypoint-video.sh /entrypoint-video.sh
RUN chmod +x /entrypoint-video.sh
ENTRYPOINT ["/entrypoint-video.sh"]
